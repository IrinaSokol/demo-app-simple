# UI base URL (Vite dev server — proxies /api to the Express app)
BASE_URL=http://localhost:5173

# Direct API base URL (Express). Default demo app uses port 3001.
# If you run `npm run build` + `npm start` at the repo root only, set both to http://localhost:3001
API_URL=http://localhost:3001

ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=admin123
